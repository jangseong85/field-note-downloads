{
  "expo": {
    "name": "119 | FIELD NOTE",
    "slug": "ems-log",
    "version": "1.0.3",
    "icon": "./assets/app-icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.emslog.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "신분증 인식과 환자 환부 사진 기록을 위해 카메라를 사용합니다. 촬영 자료는 이 기기에만 저장됩니다.",
        "NSMicrophoneUsageDescription": "환자·보호자의 동의를 받은 현장 녹취를 이 기기에 기록하기 위해 마이크를 사용합니다."
      }
    },
    "android": {
      "allowBackup": false,
      "versionCode": 4,
      "package": "com.emslog.mobile",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon.png",
        "backgroundColor": "#00666A"
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "신분증 인식과 환자 환부 사진 기록을 위해 카메라 접근을 허용해 주세요.",
          "recordAudioAndroid": false
        }
      ],
      "./plugins/withOptionalCamera",
      "./plugins/withSplashWebAsset",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000"
        }
      ],
      "react-native-document-scanner-plugin",
      [
        "expo-audio",
        {
          "microphonePermission": "환자·보호자 동의 후 현장 음성을 이 기기에 기록하기 위해 마이크 접근을 허용해 주세요.",
          "recordAudioAndroid": true
        }
      ],
      "expo-asset"
    ]
  }
}
